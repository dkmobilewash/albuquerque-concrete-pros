# Copy to .env.local for local development. Never commit real values.

# --- Lead delivery (contact form → /api/consultation/) -----------------------
# Resend API key. Without it (or without LEAD_NOTIFICATION_EMAIL) leads are
# logged to the server console instead of emailed — never dropped.
RESEND_API_KEY=
# Where new consultation requests are emailed. Comma-separate for multiple.
# CLIENT TO PROVIDE — intentionally no default.
LEAD_NOTIFICATION_EMAIL=
# Optional sender, e.g. "Albuquerque Concrete Pros <leads@albuquerqueconcretepro.com>".
# Must be on a domain verified in Resend. Defaults to Resend's shared test
# sender (onboarding@resend.dev), which only delivers to the Resend account owner.
RESEND_FROM_EMAIL=
# Optional secondary integration: JSON POST of every lead (CRM, Zapier, etc.).
CONSULTATION_WEBHOOK_URL=

# --- Analytics ---------------------------------------------------------------
# GA4 measurement ID (G-XXXXXXXXXX). Leave empty in dev/preview: the analytics
# component renders nothing when unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
